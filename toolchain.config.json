{
  "//": "TOOLCHAIN-PIN: @pellux/goodvibes-toolchain is dev-linked from a locally-built tarball (SDK commit 20093d41, packed 1.10.1). It is NOT on npm yet. The next release train must re-pin the PUBLISHED version: (1) set devDependencies['@pellux/goodvibes-toolchain'] in package.json to the published exact semver, (2) remove the '@pellux/goodvibes-toolchain' overrides entry, (3) bun update @pellux/goodvibes-toolchain and commit the moved bun.lock, (4) runtime pins (sdk/terminal-shell 1.10.1 registry) stay untouched; reusable-workflow refs stay at mgd34msu/goodvibes-sdk@main. Full recipe: TOOLCHAIN-PIN.md. This file is the repo-specific contract consumed by @pellux/goodvibes-toolchain CLIs; behavior lives in the package.",
  "packageName": "@pellux/goodvibes-agent",
  "sdkPin": {
    "sdkPackage": "@pellux/goodvibes-sdk",
    "pinSource": "devDependencies",
    "lockfile": "bun.lock",
    "overlayMarker": "node_modules/@pellux/goodvibes-sdk/.local-sdk-overlay.json",
    "sourceRoots": ["src"],
    "enforceExportsMap": false
  },
  "build": {
    "appEntrypoint": "src/main.ts",
    "outDir": "dist",
    "addonOutDir": "dist/lib",
    "prebuild": [["bun", "run", "scripts/prebuild.ts"]],
    "targets": [
      {
        "key": "linux-x64",
        "bunTarget": "bun-linux-x64",
        "appArtifact": "goodvibes-agent-linux-x64",
        "nativeAddonPackage": "sqlite-vec-linux-x64",
        "nativeAddonFile": "vec0.so"
      },
      {
        "key": "linux-arm64",
        "bunTarget": "bun-linux-arm64",
        "appArtifact": "goodvibes-agent-linux-arm64",
        "nativeAddonPackage": "sqlite-vec-linux-arm64",
        "nativeAddonFile": "vec0.so"
      },
      {
        "key": "darwin-x64",
        "bunTarget": "bun-darwin-x64",
        "appArtifact": "goodvibes-agent-macos-x64",
        "nativeAddonPackage": "sqlite-vec-darwin-x64",
        "nativeAddonFile": "vec0.dylib"
      },
      {
        "key": "darwin-arm64",
        "bunTarget": "bun-darwin-arm64",
        "appArtifact": "goodvibes-agent-macos-arm64",
        "nativeAddonPackage": "sqlite-vec-darwin-arm64",
        "nativeAddonFile": "vec0.dylib"
      }
    ]
  },
  "coverage": {
    "funcsFloor": 84,
    "linesFloor": 82,
    "command": ["bun", "test", "--coverage", "src"]
  },
  "smoke": {
    "bannerPrefix": "goodvibes-agent ",
    "forbiddenStrings": ["sqlite-vec", "$bunfs/root"],
    "binaryDefault": "dist/goodvibes-agent-linux-x64"
  },
  "releaseCut": {
    "branch": "main",
    "versionFiles": [],
    "syncCommands": [["bun", "run", "scripts/prebuild.ts"]],
    "commitPaths": [
      "package.json",
      "src/version.ts",
      "README.md",
      "CHANGELOG.md"
    ],
    "changelogHeading": "plain",
    "changelogInsertMarker": "top"
  },
  "publish": {
    "packageName": "@pellux/goodvibes-agent",
    "defaultRegistry": "https://registry.npmjs.org",
    "requiredTarballPaths": [
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "package.json",
      "src/main.ts",
      "dist/package/main.js",
      "bin/goodvibes-agent.ts",
      "tsconfig.json",
      "release/release-notes.md",
      "release/performance-snapshot.json",
      "release/release-readiness.json",
      "release/live-verification/live-verification.json",
      "release/live-verification/live-verification.md"
    ],
    "forbiddenTarballPrefixes": [
      ".github/",
      "src/test/",
      "src/.test/",
      "src/verification/",
      "src/daemon/",
      ".goodvibes/",
      "vendor/"
    ],
    "maxTarballBytes": 52428800
  },
  "perJobGreen": {
    "owner": "mgd34msu",
    "repo": "goodvibes-agent",
    "workflow": "ci.yml",
    "event": "push",
    "pollIntervalMs": 20000,
    "deadlineMs": 1800000,
    "retryAttempts": 8,
    "retryDelayMs": 7000
  }
}
