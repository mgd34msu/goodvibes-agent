{
  "name": "@pellux/goodvibes-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Proactive serial assistant/operator surface for the GoodVibes daemon, knowledge system, skills, personas, and TUI delegation.",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=22.0.0"
  },
  "bin": {
    "goodvibes-agent": "bin/goodvibes-agent.ts"
  },
  "files": [
    "bin/",
    "scripts/",
    "src/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "bun run src/main.ts",
    "tui": "bun run src/main.ts tui",
    "smoke": "bun run src/main.ts smoke",
    "smoke:cli": "bun run scripts/smoke.ts",
    "smoke:release": "bun run scripts/smoke.ts --release",
    "check:source": "bun run scripts/release-check.ts",
    "check:release": "bun run scripts/release-check.ts --release",
    "check:types": "bun run scripts/check-types.ts",
    "typecheck": "tsc --noEmit && bun run check:types",
    "test": "bun test",
    "build": "bun build src/main.ts --compile --outfile dist/goodvibes-agent"
  },
  "dependencies": {
    "@pellux/goodvibes-sdk": "0.33.30",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "6.0.3"
  },
  "keywords": [
    "goodvibes",
    "agent",
    "operator",
    "assistant",
    "daemon"
  ],
  "license": "MIT"
}
