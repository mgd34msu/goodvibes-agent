{
  "name": "@pellux/goodvibes-agent",
  "version": "0.1.78",
  "private": false,
  "description": "GoodVibes personal operator assistant TUI with a proactive Agent product brain, isolated Agent Knowledge, local profiles, routines, skills, personas, and explicit build delegation.",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "main": "src/main.ts",
  "bin": {
    "goodvibes-agent": "bin/goodvibes-agent.ts"
  },
  "files": [
    "bin",
    "LICENSE",
    "src",
    "!src/test",
    "!src/**/*.test.ts",
    "!src/**/__tests__",
    "!src/input/commands/branch-runtime.ts",
    "!src/input/commands/control-room-runtime.ts",
    "!src/input/commands/discovery-runtime.ts",
    "!src/input/commands/hooks-runtime.ts",
    "!src/input/commands/incident-runtime.ts",
    "!src/input/commands/integration-runtime.ts",
    "!src/input/commands/local-setup.ts",
    "!src/input/commands/managed-runtime.ts",
    "!src/input/commands/marketplace-runtime.ts",
    "!src/input/commands/memory-product-runtime.ts",
    "!src/input/commands/operator-panel-runtime.ts",
    "!src/input/commands/platform-services-runtime.ts",
    "!src/input/commands/profile-sync-runtime.ts",
    "!src/input/commands/provider.ts",
    "!src/input/commands/remote-runtime.ts",
    "!src/input/commands/remote-runtime-pool.ts",
    "!src/input/commands/remote-runtime-setup.ts",
    "!src/input/commands/replay-runtime.ts",
    "!src/input/commands/services-runtime.ts",
    "!src/input/commands/settings-sync-runtime.ts",
    "!src/input/commands/share-runtime.ts",
    "!src/input/commands/skills-runtime.ts",
    "!src/input/commands/teleport-runtime.ts",
    "!src/panels/cockpit-panel.ts",
    "!src/panels/communication-panel.ts",
    "!src/panels/control-plane-panel.ts",
    "!src/panels/diff-panel.ts",
    "!src/panels/forensics-panel.ts",
    "!src/panels/git-panel.ts",
    "!src/panels/hooks-panel.ts",
    "!src/panels/incident-review-panel.ts",
    "!src/panels/marketplace-panel.ts",
    "!src/panels/ops-control-panel.ts",
    "!src/panels/ops-strategy-panel.ts",
    "!src/panels/orchestration-panel.ts",
    "!src/panels/plugins-panel.ts",
    "!src/panels/remote-panel.ts",
    "!src/panels/routes-panel.ts",
    "!src/panels/sandbox-panel.ts",
    "!src/panels/services-panel.ts",
    "!src/panels/settings-sync-panel.ts",
    "!src/panels/skills-panel.ts",
    "!src/panels/watchers-panel.ts",
    "!src/panels/worktree-panel.ts",
    "!src/panels/wrfc-panel.ts",
    "!src/verification",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "docs/README.md",
    "docs/getting-started.md",
    "docs/runtime-connection.md",
    "docs/release-and-publishing.md"
  ],
  "scripts": {
    "dev": "bun run src/main.ts",
    "tui": "bun run src/main.ts",
    "dev:watch": "bun --watch src/main.ts",
    "typecheck": "bunx tsc --noEmit",
    "check:types": "bun run typecheck",
    "prebuild": "bun run scripts/prebuild.ts",
    "build": "bun build src/main.ts --compile --outfile dist/goodvibes-agent",
    "build:linux-x64": "bun build src/main.ts --compile --target=bun-linux-x64 --outfile dist/goodvibes-agent-linux-x64",
    "build:linux-arm64": "bun build src/main.ts --compile --target=bun-linux-arm64 --outfile dist/goodvibes-agent-linux-arm64",
    "build:macos-x64": "bun build src/main.ts --compile --target=bun-darwin-x64 --outfile dist/goodvibes-agent-macos-x64",
    "build:macos-arm64": "bun build src/main.ts --compile --target=bun-darwin-arm64 --outfile dist/goodvibes-agent-macos-arm64",
    "build:windows": "bun build src/main.ts --compile --target=bun-windows-x64 --outfile dist/goodvibes-agent-windows.exe",
    "build:all-shell": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:macos-x64 && bun run build:macos-arm64 && bun run build:windows",
    "test": "bun run scripts/run-tests.ts",
    "version": "bun run scripts/prebuild.ts",
    "release": "bun run scripts/release.ts",
    "release:dry": "bun run scripts/release.ts --dry-run",
    "publish:package": "bun run scripts/publish-package.ts",
    "publish:dry-run": "bun run scripts/publish-package.ts --dry-run",
    "publish:check": "bun run scripts/publish-check.ts",
    "package:install-check": "bun run scripts/package-install-check.ts",
    "build:prod": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --all",
    "perf:check": "bun run scripts/perf-check.ts",
    "architecture:check": "bun run scripts/check-architecture.ts",
    "foundation:artifacts": "bun run scripts/export-foundation-artifacts.ts",
    "verification:ledger": "bun run scripts/verification-ledger.ts",
    "verification:live": "bun run scripts/verify-live.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgd34msu/goodvibes-agent.git"
  },
  "bugs": {
    "url": "https://github.com/mgd34msu/goodvibes-agent/issues"
  },
  "homepage": "https://github.com/mgd34msu/goodvibes-agent#readme",
  "keywords": [
    "goodvibes",
    "agent",
    "operator",
    "assistant",
    "tui",
    "bun",
    "automation",
    "ai"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.16.1",
    "@anthropic-ai/bedrock-sdk": "^0.28.1",
    "@anthropic-ai/sdk": "^0.82.0",
    "@anthropic-ai/vertex-sdk": "^0.16.0",
    "@aws/bedrock-token-generator": "^1.1.0",
    "@pellux/goodvibes-sdk": "0.33.35",
    "fuse.js": "^7.1.0",
    "graphql": "^16.13.2",
    "jszip": "^3.10.1",
    "node-edge-tts": "^1.2.10",
    "openai": "^6.29.0",
    "sql.js": "^1.14.1",
    "sqlite-vec": "^0.1.9",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "@pellux/goodvibes-sdk",
    "core-js",
    "tree-sitter-css",
    "tree-sitter-javascript",
    "tree-sitter-json",
    "tree-sitter-python",
    "tree-sitter-typescript"
  ],
  "overrides": {
    "minimatch": "^10.2.5"
  }
}
